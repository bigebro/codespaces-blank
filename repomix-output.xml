                                    className="h-7 px-2 bg-slate-800 text-slate-400 hover:text-white rounded-xl text-xs cursor-pointer"
                                  >
                                    ✕
                                  </button>
                                </div>
                              ) : (
                                <button
                                  type="button"
                                  onClick={() => {
                                    setInlineAddRecipeProduct(pName);
