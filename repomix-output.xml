          // Хэрэв шинэ хүнс бол ingredients-д 0.05с-д шууд бүртгэнэ
          if (!targetIngredient) {
            const unitPrice =
              item.quantity > 0
                ? Math.round((item.total_cost || 0) / item.quantity)
