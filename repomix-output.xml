  const faHeader = [
    ["№", "ХӨРӨНГИЙН НЭР", "КОД", "АВСАН ОГНОО", "АНХНЫ ӨРТӨГ", "АШИГЛАХ САР", "САРЫН ЭЛЭГДЭЛ", "ХУРИМТЛАГДСАН ЭЛЭГДЭЛ", "ҮЛДЭГДЭЛ ӨРТӨГ"]
