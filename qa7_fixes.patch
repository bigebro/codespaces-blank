+      context.clientId,
+      ubDayStartIso(period.startDay),
+      ubDayEndIso(period.endDay),
+    );
+    return { data, named: findNamedGrade(data?.grades || [], userMessage) };
+  } catch (err) {
+    console.error("[cfo] named grade lookup failed", err);
+    return { data: null, named: null };
+  }
+}
