 export function notesPointToSpill(text?: string | null) {
   const t = String(text || "").toLowerCase();
   if (!t) return false;
+  // Таблетын «Алдагдал» товч (өмнөх ээлжийн алдагдал): эвдэрсэн/алга болсон бараа нь «Асгарсан/Алдаа».
