@@ -0,0 +1,14 @@
+const AMOUNT = /(?:\d[\d\s]*)(?:[.,]\d+)?\s*(?:₮|төгрөг|togrog|mnt)/i;
+const EXPENSE_WORDS = /зардал|зарлага|төлсөн|төлөв|авсан|худалдаж|cash|expense/i;
+
+/** Чатны текст жижиг мөнгөн зардал мэт харагдах эсэх (барааны хаягдал биш). */
+export function looksLikeCashExpense(text: string): boolean {
+  const t = String(text || "").trim();
+  if (!t) return false;
+  if (!AMOUNT.test(t) && !/\d+\s*₮/.test(t) && !/\d{3,}/.test(t)) return false;
+  if (AMOUNT.test(t) || /₮/.test(t)) return true;
+  return EXPENSE_WORDS.test(t);
+}
+
+export const CASH_EXPENSE_HINT =
+  "Энэ бол барааны хаягдал биш, жижиг зардал. «Мөнгө гаргах» товчоор, «Жижиг зардал» хэсэгт бүртгэнэ үү.";
diff --git a/src/lib/categoryLabels.ts b/src/lib/categoryLabels.ts
new file mode 100644
index 0000000..1907dd5
--- /dev/null
+++ b/src/lib/categoryLabels.ts
@@ -0,0 +1,22 @@
+/** Зөвхөн нэрний эхэнд байгаа дүрс/тэмдэгийг хасна. Эхний үгийг хасаж болохгүй. */
+export function categoryDisplayName(name: string): string {
+  const raw = String(name || "").trim();
+  if (!raw) return "";
+  const stripped = raw.replace(/^[\p{Extended_Pictographic}\p{So}\p{Sk}\s]+/u, "").trim();
+  return stripped || raw;
+}
+
+/** Ангиллын нэрийг том/жижиг үсэг үл харгалзан нэг мөр болгоно. Эхний хэлбэрийг үлдээнэ. */
+export function dedupeCategoryNames(names: string[]): string[] {
+  const seen = new Set<string>();
+  const out: string[] = [];
+  for (const raw of names) {
+    const name = categoryDisplayName(String(raw || ""));
+    if (!name) continue;
+    const key = name.toLocaleLowerCase("mn");
+    if (seen.has(key)) continue;
+    seen.add(key);
+    out.push(name);
+  }
+  return out;
+}
diff --git a/src/lib/formatUbTime.ts b/src/lib/formatUbTime.ts
new file mode 100644
index 0000000..78cfe93
--- /dev/null
+++ b/src/lib/formatUbTime.ts
@@ -0,0 +1,33 @@
+const UB = "Asia/Ulaanbaatar";
+
+/** UB цагийн 24 цагийн формат. AM/PM харуулахгүй. */
+export function formatUbTime(input: string | Date | null | undefined): string {
+  if (!input) return "—";
+  const date = input instanceof Date ? input : new Date(input);
+  if (Number.isNaN(date.getTime())) return "—";
+  const parts = new Intl.DateTimeFormat("en-GB", {
+    timeZone: UB,
+    hour: "2-digit",
+    minute: "2-digit",
+    hourCycle: "h23",
+  }).formatToParts(date);
+  const hour = parts.find((p) => p.type === "hour")?.value || "00";
+  const minute = parts.find((p) => p.type === "minute")?.value || "00";
+  return `${hour}:${minute}`;
+}
+
+export function formatUbDateTime(input: string | Date | null | undefined): string {
+  if (!input) return "—";
+  const date = input instanceof Date ? input : new Date(input);
+  if (Number.isNaN(date.getTime())) return "—";
+  const dayParts = new Intl.DateTimeFormat("en-CA", {
+    timeZone: UB,
+    year: "numeric",
+    month: "2-digit",
+    day: "2-digit",
+  }).formatToParts(date);
+  const y = dayParts.find((p) => p.type === "year")?.value || "1970";
+  const m = dayParts.find((p) => p.type === "month")?.value || "01";
+  const d = dayParts.find((p) => p.type === "day")?.value || "01";
+  return `${y}-${m}-${d} ${formatUbTime(date)}`;
+}
