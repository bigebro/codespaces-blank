# Public contact links. Use a full https URL. Leave empty to hide that button or icon.
# Messenger: https://m.me/<page>  (Meta Business Suite → your Page → Messenger link)
# LinkedIn: https://www.linkedin.com/company/<slug> or your personal profile URL
NEXT_PUBLIC_MESSENGER_URL=
NEXT_PUBLIC_LINKEDIN_URL=

# Email when a new café owner registers. Signup still succeeds if mail is not configured.
# SIGNUP_ALERT_EMAIL defaults to bigeservice@gmail.com when unset.
SIGNUP_ALERT_EMAIL=bigeservice@gmail.com
# Resend API key (https://resend.com/api-keys). Server-only. Leave empty to skip the email.
RESEND_API_KEY=
# Verified sender, e.g. Operlink <noreply@yourdomain.com>.
# If empty, Operlink <onboarding@resend.dev> is used (Resend only delivers that sender to the account email).
RESEND_FROM=
